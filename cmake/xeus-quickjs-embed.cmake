# Generates a C++ header embedding JavaScript sources as byte arrays.
#
# Usage:
#   cmake -DOUTPUT=<header> -DSOURCES=<name1>=<file1>;<name2>=<file2> -P xeus-quickjs-embed.cmake
#
# For each source, the header defines xquickjs::embedded::<name> (a null
# terminated array of unsigned char) and xquickjs::embedded::<name>_size.

set(_content "// Generated by xeus-quickjs-embed.cmake, do not edit.\n\n")
string(APPEND _content "#ifndef XQUICKJS_JS_SOURCES_HPP\n#define XQUICKJS_JS_SOURCES_HPP\n\n")
string(APPEND _content "#include <cstddef>\n\nnamespace xquickjs\n{\n    namespace embedded\n    {\n")

foreach(_source ${SOURCES})
    string(REPLACE "=" ";" _parts "${_source}")
    list(GET _parts 0 _name)
    list(GET _parts 1 _file)
    file(READ "${_file}" _hex HEX)
    string(LENGTH "${_hex}" _hex_length)
    math(EXPR _size "${_hex_length} / 2")
    # One line per 32 bytes, to keep the generated file readable
    string(REPEAT "[0-9a-f]" 64 _line_pattern)
    string(REGEX REPLACE "(${_line_pattern})" "\\1\n" _hex "${_hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    get_filename_component(_file_name "${_file}" NAME)
    string(APPEND _content "        // ${_file_name}\n")
    string(APPEND _content "        inline constexpr unsigned char ${_name}[] = {\n${_bytes}0x00};\n")
    string(APPEND _content "        inline constexpr std::size_t ${_name}_size = ${_size};\n\n")
endforeach()

string(APPEND _content "    }\n}\n\n#endif\n")

# Only touch the header when its content changes, to avoid useless rebuilds
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _previous)
endif()
if(NOT "${_previous}" STREQUAL "${_content}")
    file(WRITE "${OUTPUT}" "${_content}")
endif()
